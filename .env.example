# For true AI-generated answers choose one provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Or set LLM_PROVIDER=ollama, install Ollama and pull the chosen model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Voice input fallback when Chrome speech recognition rejects permission:
# auto = OpenAI when key is present, or local if faster-whisper is installed.
STT_PROVIDER=auto
STT_MODEL=gpt-4o-mini-transcribe
STT_LOCAL_MODEL=tiny
# Optional paid/free-tier sports APIs: WITHOUT these, news and voice still work.
CRICKET_API_KEY=
FOOTBALL_API_KEY=

# Respect cricket free API hit limits. 1200s = at most 72 calls per day per server worker.
CRICKET_CACHE_SECONDS=1200
FOOTBALL_CACHE_SECONDS=180
NEWS_CACHE_SECONDS=180
# Intended for one trusted Windows desktop or LAN-limited user only.
